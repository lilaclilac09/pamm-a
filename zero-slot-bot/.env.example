# Wallet that has UPDATE_ORACLE authority
PRIVATE_KEY=your_base58_private_key_here

# ── Pyth oracle ───────────────────────────────────────────────────────────────
# Mainnet Pyth SOL/USD price account
PYTH_SOL_USD_ACCOUNT=H6ARHf6YXhGYeQfUzQNGk6rDNnLBQKrenN712K4AQJEG

# ── Signal threshold ──────────────────────────────────────────────────────────
# Minimum price move (basis points) before firing an oracle update.
# 2 bps = 0.02% — filters noise, still reacts within one block on most moves.
MIN_UPDATE_BPS=2

# ── PMM pool parameters (must match on-chain state) ───────────────────────────
BASE_SPREAD_BPS=10
MAX_SPREAD_BPS=2000
K_PARAM=1000000
FEE_BPS=30
MAX_VOL_FACTOR=500

# ── Transaction priority & MEV ────────────────────────────────────────────────
# Priority fee in micro-lamports per compute unit.
# 100_000 = 0.1 lamport/CU — competitive for most market conditions.
PRIORITY_FEE_MICRO_LAMPORTS=100000

COMPUTE_UNITS=50000

# Jito tip in lamports (set to 0 on devnet — Jito block engine is mainnet only).
JITO_TIP_LAMPORTS=10000
