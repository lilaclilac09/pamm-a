PRIVATE_KEY=<base58-encoded-private-key>
PROGRAM_ID=<deployed-pinocchio-amm-program-id>
POOL_PUBKEY=<initialized-pool-account-pubkey>

# Pyth — SOL/USD feed id (mainnet)
PYTH_FEED_ID=ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d

# Bot 运行参数
UPDATE_INTERVAL_SECS=5

# 风险参数（bps = basis points, 1 bps = 0.01%）
