# ── Network ──────────────────────────────────────────────────────────────────
# Solana RPC endpoint. Use a private RPC for production (Helius, Triton, etc.)
RPC_URL=https://api.devnet.solana.com

# Wallet private key — base58 encoded. Fund with SOL + both tokens before starting.
PRIVATE_KEY=your_base58_private_key_here

# ── Program / pool accounts ───────────────────────────────────────────────────
# On-chain program ID (from `solana program deploy`)
PROGRAM_ID=

# Pool state account (from init-pool.js → pool-state.json: "pool")
POOL_PUBKEY=

# Pool authority PDA (from pool-state.json: "poolAuth", seeds: ["pool_auth", pool_pubkey])
POOL_AUTH=

# Token vaults owned by POOL_AUTH (from pool-state.json: "vaultA" / "vaultB")
VAULT_A=
VAULT_B=

# LP mint (from pool-state.json: "lpMint")
LP_MINT=

# Token mints for the two assets in the pool
MINT_A=
MINT_B=

# Your wallet's associated token accounts (from pool-state.json: "userA" / "userB" / "userLp")
USER_A=
USER_B=
USER_LP=

# ATA of POOL_AUTH for LP mint — receives MINIMUM_LIQUIDITY=1000 on first deposit
# (from pool-state.json: "deadLpAccount")
DEAD_LP_ACCOUNT=

# ── Oracle arm ────────────────────────────────────────────────────────────────
# Pyth price feed ID (hex, no 0x prefix). Default: SOL/USD
# Find feed IDs at: https://pyth.network/developers/price-feed-ids
PYTH_FEED_ID=ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d

# Websocket-driven: fallback polling interval if ws reconnects (ms).
# Pyth ws delivers updates every ~400ms so this is rarely used.
UPDATE_INTERVAL_MS=500

# ── Spread design ──────────────────────────────────────────────────────────────
# Effective spread = BASE_SPREAD_BPS + vol_adj
# vol_adj          = max(pyth_conf_bps, ewma_vol_bps)
#
# With BASE_SPREAD_BPS=0, spread = pure Pyth confidence + EWMA vol signal.
# In calm SOL/USD markets:  Pyth conf ≈ 1-2bps → effective spread ≈ 1-3bps
# In active markets:        EWMA widens automatically → protects LPs
# During black-swan events: hard cap at MAX_VOL_FACTOR
#
# Trader total cost = spread + fee = ~3-5bps in calm conditions.
# That is tighter than Binance spot (10bps) and Uniswap v3 5bp tier.
BASE_SPREAD_BPS=0

# PMM curvature. 500 reduces price impact on uninformed flow, doesn't affect arbs.
K_PARAM=500

# 2bp fee goes entirely to LPs on every swap.
# Sim result at 200bps/yr vol: fee/IL ratio = 2.49x — LPs profitable.
FEE_BPS=2

# Hard cap on vol-adjusted spread during extreme volatility (bps).
MAX_VOL_FACTOR=200

# Oracle update trigger: fire on any 1bp move (websocket latency ~50ms).
# Lower = fresher pool = narrower arb window = safer tight spread.
MIN_ORACLE_UPDATE_BPS=1

# TWAP freshness guarantee: force send every 10s regardless of price moves.
MAX_ORACLE_SILENCE_SECS=10

# Optional: pin rebalance targets written into UPDATE_ORACLE.
# Defaults to current on-chain pool reserves if unset (recommended).
# Set to override — e.g. to hold a fixed ratio regardless of actual reserves.
# TARGET_A=1000000000
# TARGET_B=1000000000

# ── Trading arm ───────────────────────────────────────────────────────────────
# How often the trading arm runs (milliseconds)
TRADE_INTERVAL_MS=5000

# Max size of a single Jupiter swap in lamports (default: 0.1 SOL = 100_000_000)
MAX_TRADE_LAMPORTS=100000000

# Inventory rebalance thresholds — fraction of total pool value held in token A
# If ratio > REBALANCE_HIGH: remove liquidity to reduce exposure
# If ratio < REBALANCE_LOW:  add liquidity (requires wallet balance)
REBALANCE_HIGH=0.72
REBALANCE_LOW=0.38

# Jito tip in lamports per bundle (default: 10_000 = 0.00001 SOL)
JITO_TIP_LAMPORTS=10000

# Jito block engine endpoint — pick the region closest to your server
# Options: ny / amsterdam / frankfurt / tokyo / slc
JITO_ENDPOINT=https://ny.mainnet.block-engine.jito.wtf/api/v1/bundles

# Jito tip account (one of 8 official accounts — default is valid for mainnet)
JITO_TIP_ACCOUNT=96gYZGLnJYVFmbjzopPSU6QiEV5fG3u3Z4M7o7G1z5b

# TWAP sanity: reject Jupiter quotes deviating more than this from on-chain TWAP (bps)
MAX_PRICE_DEVIATION_BPS=200

# TWAP sanity: reject if the newest on-chain TWAP observation is older than this (seconds)
# Tip: set to 300 during warm-up before the oracle arm has populated observations
MAX_TWAP_AGE_SECS=10

# Jupiter slippage tolerance for swaps (bps, default: 80 = 0.8%)
SLIPPAGE_BPS=80

# ── Risk ──────────────────────────────────────────────────────────────────────
# Trip the circuit breaker after this many consecutive failures in either arm
MAX_CONSECUTIVE_FAILURES=5

# Daily loss limit as a fraction of starting balance (e.g. 0.05 = 5%)
# Bot halts if (start_balance - current_balance) / start_balance exceeds this
MAX_DAILY_LOSS_PCT=0.05

# ── Metrics ───────────────────────────────────────────────────────────────────
# HTTP port for /health and /metrics endpoints
METRICS_PORT=3000

# ── HumidiFi arb arm ─────────────────────────────────────────────────────────
# Helius Yellowstone gRPC endpoint (find in Helius dashboard → gRPC)
# Format: https://YOUR-RPC.helius-rpc.com  (bot uses port 443 + TLS)
YELLOWSTONE_ENDPOINT=https://YOUR-HELIUS-GRPC-ENDPOINT.helius-rpc.com

# Yellowstone access token (also from Helius dashboard)
YELLOWSTONE_TOKEN=your-yellowstone-token-here
